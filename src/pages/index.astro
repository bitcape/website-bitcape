---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

// Resolve the hero image against the configured `base` so it works on
// GitHub Pages project sites as well as at the root / a custom domain.
const heroImage =
  import.meta.env.BASE_URL.replace(/\/$/, '') + '/mx_keys.jpg';
---

<BaseLayout>
  <section class="hero" style={`--hero-image: url('${heroImage}')`}>
    <div class="hero__content">
      <h1 class="hero__name">{site.title}</h1>
      <p class="hero__subtitle">{site.subtitle}</p>
      <p class="hero__tagline">{site.tagline}</p>
      <a class="button hero__cta" href={`mailto:${site.email}`}>Contact</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: var(--space-lg);
    text-align: center;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  /* Hero background image (path provided via the --hero-image variable). */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--hero-image);
    background-size: cover;
    background-position: center;
  }

  /* Dark overlay to keep text readable over the background image. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      160deg,
      rgba(15, 12, 8, 0.55) 0%,
      rgba(15, 12, 8, 0.72) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 40rem;
    display: grid;
    gap: var(--space-md);
    justify-items: center;
  }

  .hero__name {
    font-size: var(--step-3);
    letter-spacing: 0.01em;
  }

  .hero__subtitle {
    font-size: var(--step-1);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .hero__tagline {
    font-size: var(--step-1);
    color: var(--color-text);
  }

  .hero__cta {
    margin-top: var(--space-sm);
  }
</style>



